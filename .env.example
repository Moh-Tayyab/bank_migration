# API Authentication (leave empty to disable auth)
API_KEY=

# Environment (production disables auth bypass, docs, and debug)
ENVIRONMENT=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Server
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Database
DB_USER=bank_user
DB_PASSWORD=bank_pass
DB_NAME=bank_migration

# Canonical Store Encryption (32+ byte random string)
CANONICAL_ENCRYPTION_KEY=your_secure_random_32_byte_key_here

# AI Agent API Key (Gemini via OpenAI-compatible endpoint)
OPENAI_API_KEY=your_gemini_api_key_here

# Celery (for Docker deployment — local dev uses defaults)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Data Retention (hours; 0 = disabled / never clean up)
UPLOAD_TTL_HOURS=0
OUTPUT_TTL_HOURS=168
AUDIT_TTL_HOURS=720
CANONICAL_TTL_HOURS=72
CLEANUP_ON_STARTUP=true
CLEANUP_DRY_RUN=false
