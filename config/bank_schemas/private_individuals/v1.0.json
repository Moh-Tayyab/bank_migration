  "mandatory_fields": [
    "ListRecordId",
    "ListRecordType",
    "FullName",
    "FamilyName",
    "AddedDate",
    "LastUpdatedDate"
  ],
  "transformation_rules": {
    "name_concatenation": {
      "source_fields": ["first_name", "last_name"],
      "target_field": "FullName",
      "logic": "IF first_name IS NULL THEN last_name ELSE first_name + ' ' + last_name"
    },
    "entity_detection": {
      "condition": "first_name IS NULL",
      "actions": [
        "Set NameType = 'Entity Name'",
        "Set IsEntity = true",
        "Set DataConfidenceScore = 60"
      ]
    },
    "risk_scoring": {
      "matrix": {
        "CRIME - TERROR": 100,
        "NONCONVICTION TERROR": 95,
        "CRIME - WAR": 90,
        "CRIME - FINANCIAL": 85,
        "POLITICAL INDIVIDUAL": 70,
        "INDIVIDUAL": 50
      },
      "pep_boost": 10
    },
    "record_type_derivation": {
      "rules": [
        "IF sub-category = 'PEP' THEN ListRecordType = 'PEP'",
        "IF category contains 'CRIME' OR 'TERROR' THEN ListRecordType = 'SAN'",
        "IF category = 'POLITICAL INDIVIDUAL' THEN ListRecordType = 'SIP'",
        "DEFAULT ListRecordType = 'SIP'"
      ]
    },
    "date_validation": {
      "format": "ISO 8601",
      "validations": [
        "date must not be in future",
        "LastUpdatedDate must be >= AddedDate"
      ]
    }
  },
  "compliance_notes": {
    "screening_lists": ["OFAC SDN", "UN Sanctions", "EU Sanctions", "UK Sanctions", "PEP Database"],
    "ongoing_monitoring": true,
    "risk_based_approach": true,
    "audit_requirements": [
      "Maintain transformation audit trail",
      "Log all data quality issues",
      "Track manual review decisions",
      "Document risk scoring rationale"
    ]
  }
}
